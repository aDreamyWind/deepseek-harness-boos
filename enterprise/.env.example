# Web Host configuration only. Never put a real secret in this example.
HARNESS_ADMIN_OIDC_ISSUER=http://localhost:8080
HARNESS_ADMIN_GATEWAY_BASE_URL=http://localhost:8080/v1
HARNESS_ADMIN_MODELS='[{"id":"your-admin-model-code"}]'
HARNESS_ADMIN_WEB_OIDC_CLIENT_ID=your-web-client-id
HARNESS_ADMIN_WEB_OIDC_CLIENT_SECRET=replace-with-host-only-secret
HARNESS_ADMIN_WEB_OIDC_REDIRECT_URI=http://127.0.0.1:3080/oauth/callback

# Public Desktop client; alternatively use desktop.patch.example.yml.
DSH_ENTERPRISE_DESKTOP_OIDC_CLIENT_ID=your-public-desktop-client-id
