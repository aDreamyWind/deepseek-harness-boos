# Harness Admin enterprise Web configuration for local development.
HARNESS_ADMIN_OIDC_ISSUER=http://localhost:8080
HARNESS_ADMIN_GATEWAY_BASE_URL=http://localhost:8080/v1
HARNESS_ADMIN_MODELS='[{"id":"replace-with-harness-admin-model-code","name":"Enterprise model"}]'

HARNESS_ADMIN_WEB_OIDC_CLIENT_ID=replace-with-web-client-id
HARNESS_ADMIN_WEB_OIDC_CLIENT_SECRET=replace-with-web-client-secret
HARNESS_ADMIN_WEB_OIDC_REDIRECT_URI=http://127.0.0.1:3080/oauth/callback
