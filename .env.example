# Harness Admin enterprise Web configuration for local development.
DSH_ENTERPRISE_OIDC_ISSUER=http://localhost:8080
DSH_ENTERPRISE_GATEWAY_BASE_URL=http://localhost:8080/v1
DSH_ENTERPRISE_MODELS='[{"id":"replace-with-harness-admin-model-code","name":"Enterprise model"}]'
DSH_ENTERPRISE_ALLOW_LOOPBACK_HTTP=true

DSH_ENTERPRISE_WEB_OIDC_CLIENT_ID=replace-with-web-client-id
DSH_ENTERPRISE_WEB_OIDC_CLIENT_SECRET=replace-with-web-client-secret
DSH_ENTERPRISE_WEB_OIDC_REDIRECT_URI=http://127.0.0.1:3080/oauth/callback
